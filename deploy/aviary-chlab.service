[Unit]
Description=Aviary ClickHouse verification lab
After=docker.service
Requires=docker.service

[Service]
Type=simple
User=root
Group=ubuntu
WorkingDirectory=/
Environment=PATH=/usr/bin:/bin
ExecStart=/usr/local/bin/aviary-chlab chlab-service
Restart=on-failure
RestartSec=2
UMask=0077

[Install]
WantedBy=multi-user.target
